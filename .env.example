# Copy to .env.local and fill in. Never commit a filled-in copy: .env* is
# git-ignored. Every name here is server-only — none may be given a
# NEXT_PUBLIC_ prefix, which would publish it to the browser.

# PostgreSQL connection string.
# Local:      postgresql://USER@127.0.0.1:5432/yiddiweller_dev
# Railway:    copy from the Postgres service's Connect tab. Prefer the private
#             URL so traffic stays inside Railway's network.
DATABASE_URL=

# Resend API key with Sending access. https://resend.com → API Keys
RESEND_API_KEY=

# Address mail is sent FROM. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=website@yiddiweller.com

# Address inquiry notifications are delivered TO. Any inbox you read.
CONTACT_EMAIL=

# Absolute origin this deployment is reached at, with no trailing slash.
# Local:      http://localhost:3000
# Beta:       https://yiddiweller-beta.up.railway.app
# Production: https://studio.yiddiweller.com  <- the Studio origin, not the
#             public one: sign-in links and the session cookie are built from
#             it, and the public site never reads it.
# Studio sign-in links are built from it, so a wrong value sends beta links to
# production. Each environment sets its own; there is no shared default.
APP_URL=

# Secret Studio uses to sign sessions and sign-in links. Generate a fresh one
# per environment and never reuse production's:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out, which is the intended behaviour in an
# incident.
BETTER_AUTH_SECRET=

# The host Studio answers on at its root. Production sets it to
# studio.yiddiweller.com. Leave it unset locally and on beta, where Studio is
# reached at /studio instead; on the public production host it is what makes
# /studio answer 404.
STUDIO_HOST=

# Set to "preview" on the beta service only. Blocks all search engine
# indexing. Production must leave this unset.
SITE_ENV=
